# Limyrx Chat - Production (chat.limyrx.xyz)
# Backend services should be reverse-proxied to subdomains:
#   api.limyrx.xyz    -> localhost:14702 (API)
#   events.limyrx.xyz -> localhost:14703 (Events/WebSocket)
#   autumn.limyrx.xyz -> localhost:14704 (Media/Uploads)
#   january.limyrx.xyz -> localhost:14705 (Embeds/Proxy)
#   gifbox.limyrx.xyz -> localhost:14706 (Gifbox)
#   livekit.limyrx.xyz -> localhost:7880  (Voice/WebRTC)

VITE_API_URL=https://api.limyrx.xyz
VITE_WS_URL=wss://events.limyrx.xyz
VITE_MEDIA_URL=https://autumn.limyrx.xyz
VITE_PROXY_URL=https://january.limyrx.xyz
VITE_GIFBOX_URL=https://gifbox.limyrx.xyz

# specify hCaptcha sitekey
VITE_HCAPTCHA_SITEKEY=

# specify Sentry DSN
VITE_SENTRY_DSN=
VITE_SENTRY_TUNNEL=

# configs
VITE_CFG_ENABLE_VIDEO=true
